{
  "dataset": "Criteo uplift covariates with synthetic treatment/outcomes",
  "input_file": "data\\criteo_sample_200k.parquet",
  "output_file": "data\\processed\\criteo_semisynthetic_200k.csv",
  "n_rows": 200000,
  "n_features": 12,
  "feature_columns": [
    "f0",
    "f1",
    "f2",
    "f3",
    "f4",
    "f5",
    "f6",
    "f7",
    "f8",
    "f9",
    "f10",
    "f11"
  ],
  "raw_feature_columns": [
    "raw_f0",
    "raw_f1",
    "raw_f2",
    "raw_f3",
    "raw_f4",
    "raw_f5",
    "raw_f6",
    "raw_f7",
    "raw_f8",
    "raw_f9",
    "raw_f10",
    "raw_f11"
  ],
  "treatment_column": "W",
  "outcome_column": "Y",
  "ground_truth_column": "tau_level",
  "scenario": "opposed",
  "zero_rate_target": 0.9,
  "sigma": 0.8,
  "treatment_probability": 0.5,
  "seed": 2026,
  "standardization": "sample mean and standard deviation",
  "original_treatment_and_outcomes_used": false,
